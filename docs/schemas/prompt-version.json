{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://promptstdio.com/schemas/prompt-version.v1.deprecated.json",
  "title": "PromptVersion（已废止 · ADR-018）",
  "description": "用户侧 prompt_versions 已停写并清空；本 Schema 仅作历史参考。平台官方版本见 system_prompt_versions。",
  "deprecated": true,
  "type": "object",
  "properties": {
    "id": { "type": "integer" },
    "version_number": { "type": "integer" },
    "major_version": { "type": "integer" },
    "minor_version": { "type": "integer" },
    "version_label": { "type": "string", "examples": ["v2", "v1.2"] },
    "version_mode": { "type": "string", "enum": ["original", "revision"] },
    "change_note": { "type": "string", "minLength": 1 },
    "parent_id": { "type": ["integer", "null"] },
    "baseline_system_version_id": { "type": ["integer", "null"] },
    "content": { "type": "string" },
    "parameters": { "type": "array" },
    "created_by": { "type": ["integer", "null"] },
    "created_at": { "type": "string", "format": "date-time" },
    "merge_meta": { "type": ["object", "null"] }
  }
}
